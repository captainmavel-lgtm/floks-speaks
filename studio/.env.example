# ---------------------------------------------------------------------------
# Floks Speaks — Sanity Studio environment
#
# Copy this file to `studio/.env` and fill in the values, then build/deploy:
#
#   cd studio
#   npm run deploy
#
# Sanity inlines any SANITY_STUDIO_* value into the studio bundle AT BUILD
# TIME. That means:
#   - these must be present when you run `npm run deploy`, and
#   - changing a value requires a fresh deploy to take effect.
# ---------------------------------------------------------------------------

# The live site that hosts the /api/audio/upload route. No trailing slash.
SANITY_STUDIO_UPLOAD_URL=https://floksspeaks.org

# Must match AUDIO_UPLOAD_SECRET in the Netlify environment variables.
# Netlify: Site configuration → Environment variables → AUDIO_UPLOAD_SECRET
#
# NOTE: this value is compiled into the studio's public JavaScript bundle, so
# treat it as a shared key that gates uploads, not as a private credential.
# Rotate it in both places (Netlify and here) if you ever need to revoke it.
SANITY_STUDIO_UPLOAD_SECRET=
